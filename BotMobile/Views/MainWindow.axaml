<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BotMobile.Views.MainWindow"
        Title="Bot Mobile"
        Width="1180" Height="760" Background="#0A0E17"
        RequestedThemeVariant="Dark">

  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0A0E17" />
    <SolidColorBrush x:Key="BgPanel" Color="#0D1420" />
    <SolidColorBrush x:Key="Surface" Color="#101827" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#162238" />
    <SolidColorBrush x:Key="Cyan" Color="#00E5FF" />
    <SolidColorBrush x:Key="TextDim" Color="#849396" />
    <SolidColorBrush x:Key="TextMain" Color="#DFE2EF" />
    <SolidColorBrush x:Key="Green" Color="#39FF14" />
    <SolidColorBrush x:Key="Amber" Color="#FFB020" />
    <SolidColorBrush x:Key="Red" Color="#FF4D67" />
  </Window.Resources>

  <Grid ColumnDefinitions="220,*">

    <!-- ============ SIDEBAR ============ -->
    <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="#1A2333" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,22,16,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="◆" FontSize="20" Foreground="{StaticResource Cyan}" />
            <TextBlock Text="Bot Mobile" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
          </StackPanel>
          <TextBlock Text="Facebook Automation" FontSize="11" Margin="28,0,0,0" Foreground="{StaticResource TextDim}" />
        </StackPanel>

        <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" Margin="0,18,0,0" Spacing="2">
          <Button x:Name="NavFitur" Click="OnNav" Tag="fitur" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" BorderThickness="0,0,0,0" Padding="18,11" FontSize="14" FontWeight="SemiBold">
            <TextBlock Text="Fitur Bot" />
          </Button>
          <Button x:Name="NavAkun" Click="OnNav" Tag="akun" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Padding="18,11" FontSize="14">
            <TextBlock Text="Data Akun" />
          </Button>
          <Button x:Name="NavUid" Click="OnNav" Tag="uid" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Padding="18,11" FontSize="14">
            <TextBlock Text="UID" />
          </Button>
          <Button x:Name="NavLink" Click="OnNav" Tag="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Padding="18,11" FontSize="14">
            <TextBlock Text="Link" />
          </Button>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="14" Padding="10,8" Background="{StaticResource Surface}"
                BorderBrush="#1A2333" BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" />
              <TextBlock x:Name="TxtChromeChip" Text="Chrome: OK" FontSize="11" Foreground="{StaticResource TextDim}" />
            </StackPanel>
            <TextBox x:Name="TxtChrome" Watermark="(auto-detect)" FontSize="11" Margin="0,6,0,4" />
            <Button x:Name="BtnSaveChrome" Content="Simpan Path" Click="OnSaveChrome" FontSize="11"
                    HorizontalAlignment="Stretch" Height="26" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ============ MAIN ============ -->
    <Grid Grid.Column="1" RowDefinitions="64,*,190" Margin="0">
      <!-- top bar -->
      <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="#1A2333" BorderThickness="0,0,0,1"
              Padding="24,0">
        <DockPanel VerticalAlignment="Center">
          <Button x:Name="BtnRun" DockPanel.Dock="Right" Click="OnRunBot" Background="{StaticResource Cyan}"
                  Foreground="#00363A" FontWeight="Bold" Padding="20,8" FontSize="14" HorizontalContentAlignment="Center">
            ▶ Jalankan Bot
          </Button>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TxtPageTitle" Text="Fitur Bot" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
            <TextBlock x:Name="TxtPageSub" Text="Urutan eksekusi per akun" FontSize="11" Foreground="{StaticResource TextDim}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- page host -->
      <ContentControl x:Name="PageHost" Grid.Row="1" Margin="24,16,24,8" />

      <!-- log console -->
      <Border Grid.Row="2" Margin="24,4,24,16" Background="{StaticResource BgPanel}"
              BorderBrush="#1A2333" BorderThickness="1" CornerRadius="4" Padding="10,6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="2,2,0,6">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" />
            <TextBlock Text="LOG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}" />
            <TextBlock x:Name="TxtInfo" FontSize="10" Foreground="{StaticResource TextDim}" Margin="12,0,0,0" />
          </StackPanel>
          <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                   BorderThickness="0" FontFamily="Consolas,monospace" FontSize="11.5"
                   Foreground="{StaticResource TextMain}" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
