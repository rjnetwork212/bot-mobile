<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BotMobile.Views.FeatureConfigWindow"
        Title="Konfigurasi Fitur" Width="440" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">

  <StackPanel Margin="14" Spacing="10">
    <TextBlock x:Name="TxtTitle" FontWeight="Bold" FontSize="15" />
    <TextBlock x:Name="TxtDesc" TextWrapping="Wrap" Foreground="Gray" />
    <Separator />
    <StackPanel x:Name="PanelParams" Spacing="10" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="BtnOk" Content="Simpan" Click="OnOk" />
      <Button Content="Batal" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
